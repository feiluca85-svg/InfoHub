<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="20dp">

    <!-- Top Left: Current Weather -->
    <LinearLayout
        android:id="@+id/current_weather_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        
        <ImageView
            android:id="@+id/widget_main_icon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_sun"
            android:layout_marginEnd="12dp" />
            
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textColor="#ffffff"
                android:textSize="56sp"
                android:fontFamily="sans-serif-light"
                android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
            <TextView
                android:id="@+id/widget_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="..."
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:fontFamily="sans-serif"
                android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top Right: Clock, Date, City -->
    <LinearLayout
        android:id="@+id/clock_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:gravity="end"
        android:orientation="vertical">
        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#ffffff"
            android:textSize="72sp"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#ffffff"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
        <TextView
            android:id="@+id/widget_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#dddddd"
            android:textSize="18sp"
            android:fontFamily="sans-serif"
            android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
    </LinearLayout>

    <!-- Bottom: 3 Days Forecast as a vertical list -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:orientation="vertical">
        
        <!-- Day 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <ImageView
                android:id="@+id/widget_day1_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_cloud"
                android:layout_marginEnd="16dp" />
            <TextView
                android:id="@+id/widget_day1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
            <TextView
                android:id="@+id/widget_day1_temps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--/--°"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:fontFamily="sans-serif"
                android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
        </LinearLayout>
        
        <!-- Day 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <ImageView
                android:id="@+id/widget_day2_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_cloud"
                android:layout_marginEnd="16dp" />
            <TextView
                android:id="@+id/widget_day2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
            <TextView
                android:id="@+id/widget_day2_temps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--/--°"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:fontFamily="sans-serif"
                android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
        </LinearLayout>

        <!-- Day 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/widget_day3_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_cloud"
                android:layout_marginEnd="16dp" />
            <TextView
                android:id="@+id/widget_day3_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
            <TextView
                android:id="@+id/widget_day3_temps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--/--°"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:fontFamily="sans-serif"
                android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>
