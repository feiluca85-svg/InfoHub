<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="20dp">

    <ImageView
        android:id="@+id/widget_main_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_alignParentStart="true"
        android:layout_alignTop="@+id/widget_clock"
        android:layout_alignBottom="@+id/widget_condition"
        android:layout_marginEnd="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sun" />

    <!-- CLOCK (Top Right) -->
    <TextClock
        android:id="@+id/widget_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:textColor="#ffffff"
        android:textSize="76sp"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />

    <!-- TEMP (Aligned with Clock, Left of Clock) -->
    <TextView
        android:id="@+id/widget_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_main_icon"
        android:layout_alignBaseline="@id/widget_clock"
        android:text="--°"
        android:textColor="#ffffff"
        android:textSize="76sp"
        android:fontFamily="sans-serif-light"
        android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />

    <!-- DATE (Below Clock, Right) -->
    <TextView
        android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_clock"
        android:layout_alignParentEnd="true"
        android:text="--"
        android:textColor="#ffffff"
        android:textSize="22sp"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />

    <!-- CONDITION (Aligned with Date, Left of Date) -->
    <TextView
        android:id="@+id/widget_condition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/widget_main_icon"
        android:layout_alignBaseline="@id/widget_date"
        android:text="..."
        android:textColor="#ffffff"
        android:textSize="22sp"
        android:fontFamily="sans-serif"
        android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />

    <!-- CITY (Below Date, Right) -->
    <TextView
        android:id="@+id/widget_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_date"
        android:layout_alignParentEnd="true"
        android:text="--"
        android:textColor="#dddddd"
        android:textSize="18sp"
        android:fontFamily="sans-serif"
        android:shadowColor="#80000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3" />
</RelativeLayout>
